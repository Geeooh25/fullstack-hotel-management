<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin' %> - GEEOOH HOTEL Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
  <style>
    :root {
        --gold: #B8860B;
        --gold-dark: #8B691B;
        --gold-light: #F5E6D3;
        --text-dark: #1A1A1A;
        --text-light: #666666;
        --white: #FFFFFF;
        --cream: #FDF8F0;
        --gray-bg: #FAFAFA;
        --shadow: 0 10px 30px rgba(0,0,0,0.05);
        --transition: all 0.3s ease;
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', 'Segoe UI', sans-serif; background: var(--gray-bg); }
    
    /* Sidebar */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 260px;
        height: 100%;
        background: var(--text-dark);
        color: white;
        z-index: 1000;
        transition: var(--transition);
    }
    
    .sidebar-header {
        padding: 25px 20px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    
    .sidebar-header h3 { color: var(--gold); margin: 0; font-family: 'Playfair Display', serif; }
    .sidebar-header p { font-size: 0.75rem; opacity: 0.7; margin: 5px 0 0; }
    
    .sidebar-nav { padding: 20px 15px; }
    
    .nav-item {
        display: block;
        padding: 12px 15px;
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        border-radius: 8px;
        transition: var(--transition);
    }
    
    .nav-item:hover, .nav-item.active { background: rgba(184, 134, 11, 0.2); color: var(--gold); }
    .nav-item i { width: 25px; margin-right: 10px; }
    
    .sidebar-user {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 20px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }
    
    .logout-btn {
        width: 100%;
        background: rgba(220, 53, 69, 0.2);
        border: none;
        color: #dc3545;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        transition: var(--transition);
    }
    
    .logout-btn:hover { background: #dc3545; color: white; }
    
    /* Main Content */
    .main-content { margin-left: 260px; padding: 20px; }
    
    .welcome-section {
        background: white;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: var(--shadow);
    }
    
    .welcome-text h2 { font-size: 1.5rem; color: var(--text-dark); margin: 0; }
    .welcome-text h2 span { color: var(--gold); }
    
    /* Cards */
    .stats-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
        transition: var(--transition);
    }
    
    .stats-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
    .stats-number { font-size: 32px; font-weight: bold; color: var(--gold); margin-top: 10px; }
    .stats-card h5 { color: var(--text-light); margin: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
    
    /* Tables */
    .table-container {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--shadow);
    }
    
    .table { margin-bottom: 0; }
    .table thead th { border-bottom: 2px solid var(--gold); color: var(--text-dark); font-weight: 600; }
    
    /* Badges */
    .badge-success { background: #28a745; color: white; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; }
    .badge-warning { background: #ffc107; color: #333; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; }
    .badge-danger { background: #dc3545; color: white; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; }
    .badge-info { background: #17a2b8; color: white; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; }
    
    /* Buttons */
    .btn-gold {
        background: var(--gold);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        transition: var(--transition);
    }
    .btn-gold:hover { background: var(--gold-dark); transform: translateY(-2px); }
    
    .btn-outline-gold {
        background: transparent;
        border: 2px solid var(--gold);
        color: var(--gold);
        padding: 8px 20px;
        border-radius: 8px;
        transition: var(--transition);
    }
    .btn-outline-gold:hover { background: var(--gold); color: white; }
    
    /* Mobile Toggle */
    .mobile-toggle {
        display: none;
        position: fixed;
        top: 15px;
        left: 15px;
        z-index: 1001;
        background: var(--text-dark);
        border: none;
        color: white;
        font-size: 1.5rem;
        padding: 10px 15px;
        border-radius: 8px;
        cursor: pointer;
    }
    
    @media (max-width: 992px) {
        .sidebar { transform: translateX(-100%); }
        .sidebar.active { transform: translateX(0); }
        .main-content { margin-left: 0; }
        .mobile-toggle { display: block; }
    }
</style>
</head>
<body>

    <button class="mobile-toggle" id="mobileToggle">
        <i class="fas fa-bars"></i>
    </button>
    
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h3>GEEOOH HOTEL</h3>
            <p>Administrator Panel</p>
        </div>
        
        <div class="sidebar-nav">
    <a href="/admin/dashboard" class="nav-item">
        <i class="fas fa-chart-line"></i> Dashboard
    </a>
    <a href="/admin/bookings" class="nav-item">
        <i class="fas fa-calendar-check"></i> Bookings
    </a>
    <a href="/admin/rooms" class="nav-item">
        <i class="fas fa-bed"></i> Rooms
    </a>
    <a href="/admin/amenities" class="nav-item">
        <i class="fas fa-concierge-bell"></i> Amenities
    </a>
    <a href="/admin/users" class="nav-item">
        <i class="fas fa-users"></i> Users
    </a>
    <a href="/admin/requests" class="nav-item">
        <i class="fas fa-headset"></i> Requests
    </a>
    <a href="/admin/menu" class="nav-item">
        <i class="fas fa-utensils"></i> Menu
    </a>
    <a href="/admin/reports" class="nav-item">
        <i class="fas fa-chart-bar"></i> Reports
    </a>
    <a href="/admin/settings" class="nav-item">
        <i class="fas fa-cog"></i> Settings
    </a>
    <a href="/admin/activity" class="nav-item">
        <i class="fas fa-history"></i> Activity Logs
    </a>
</div>
        
        <div class="sidebar-user">
    <div class="user-name" style="margin-bottom: 15px;">
        <i class="fas fa-user-circle"></i> 
        <%= session.admin ? session.admin.name : 'Admin' %>
    </div>
    <a href="/admin/logout" class="logout-btn" style="display: block; text-align: center; text-decoration: none;">
        <i class="fas fa-sign-out-alt"></i> Logout
    </a>
</div>
    </div>
    
    <div class="main-content">
        <div class="welcome-section">
            <div class="welcome-text">
                <h2>Welcome back, <span><%= typeof user !== 'undefined' && user ? user.first_name : (typeof session !== 'undefined' && session.admin ? session.admin.name.split(' ')[0] : 'Admin') %></span>!</h2>
                <p>Here's what's happening with your hotel today.</p>
            </div>
        </div>
        <%- body %>
    </div>
    
    <script>
        const mobileToggle = document.getElementById('mobileToggle');
        const sidebar = document.getElementById('sidebar');
        if (mobileToggle) {
            mobileToggle.addEventListener('click', () => {
                sidebar.classList.toggle('active');
            });
        }
    </script>
</body>
</html>