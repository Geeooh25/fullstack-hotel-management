<!DOCTYPE html>
<html>
<head>
    <title>Rooms - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 bg-dark vh-100 p-3">
                <h4 class="text-white">Admin Panel</h4>
                <hr class="bg-light">
                <ul class="nav flex-column">
                    <li class="nav-item"><a href="/admin/dashboard" class="nav-link text-white">Dashboard</a></li>
                    <li class="nav-item"><a href="/admin/bookings" class="nav-link text-white">Bookings</a></li>
                    <li class="nav-item"><a href="/admin/rooms" class="nav-link text-white">Rooms</a></li>
                    <li class="nav-item"><a href="/admin/amenities" class="nav-link text-white">Amenities</a></li>
                    <li class="nav-item"><a href="/admin/users" class="nav-link text-white">Users</a></li>
                    <li class="nav-item"><a href="/admin/requests" class="nav-link text-white">Requests</a></li>
                    <li class="nav-item"><a href="/admin/menu" class="nav-link text-white">Menu</a></li>
                    <li class="nav-item"><a href="/admin/reports" class="nav-link text-white">Reports</a></li>
                    <li class="nav-item"><a href="/admin/settings" class="nav-link text-white">Settings</a></li>
                    <li class="nav-item"><a href="/admin/activity" class="nav-link text-white">Activity Log</a></li>
                    <li class="nav-item mt-4"><a href="/admin/logout" class="nav-link text-white">Logout</a></li>
                </ul>
            </div>
            <div class="col-md-10 p-4">
                <h2>Rooms Management</h2>
                <div class="alert alert-info">Rooms module is ready.</div>
                <table class="table">
                    <thead>
                        <tr><th>Room #</th><th>Type</th><th>Floor</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <% rooms.forEach(room => { %>
                        <tr>
                            <td><%= room.room_number %></td>
                            <td><%= room.RoomType ? room.RoomType.name : 'N/A' %></td>
                            <td><%= room.floor || 'N/A' %></td>
                            <td><span class="badge bg-<%= room.status === 'available' ? 'success' : 'warning' %>"><%= room.status %></span></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>