<div class="row">
    <div class="col-md-12">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5><i class="fas fa-history"></i> Activity Logs</h5>
                <button class="btn btn-sm btn-secondary" id="refreshLogs">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Admin</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>IP Address</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (logs && logs.length > 0) { %>
                            <% logs.forEach(log => { 
                                let roleColor = '';
                                if (log.details && log.details.role === 'super_admin') roleColor = '#dc3545';
                                else if (log.details && log.details.role === 'admin') roleColor = '#ffc107';
                                else if (log.details && log.details.role === 'receptionist') roleColor = '#17a2b8';
                                else roleColor = '#6c757d';
                            %>
                                <tr>
                                    <td style="white-space: nowrap;"><%= new Date(log.created_at).toLocaleString() %></td>
                                    <td><%= log.admin_username %></td>
                                    <td>
                                        <span class="badge" style="background: <%= roleColor %>; color: <%= log.details && log.details.role === 'admin' ? '#333' : 'white' %>;">
                                            <%= log.details && log.details.role ? log.details.role : 'staff' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge <%= log.action === 'login' ? 'bg-success' : 'bg-warning' %>">
                                            <%= log.action %>
                                        </span>
                                    </td>
                                    <td><%= log.ip_address || 'N/A' %></td>
                                    <td><%= log.user_agent ? log.user_agent.substring(0, 50) + '...' : '-' %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6" class="text-center">No activity logs found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('refreshLogs')?.addEventListener('click', () => location.reload());
</script>