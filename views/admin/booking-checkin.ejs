<div class="row">
    <div class="col-md-12">
        <div class="stats-card">
            <h5>Check-in Guest</h5>
            <form id="checkinForm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Booking Reference</label>
                        <input type="text" name="booking_reference" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Guest Email</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">ID Card Number</label>
                    <input type="text" name="id_card" class="form-control">
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" name="id_verified" class="form-check-input">
                    <label class="form-check-label">ID Verified</label>
                </div>
                <button type="submit" class="btn-gold">Confirm Check-in</button>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('checkinForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());
        const response = await fetch('/api/bookings/checkin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (response.ok) {
            alert('Check-in successful!');
            window.location.href = '/admin/bookings';
        } else {
            alert('Check-in failed');
        }
    });
</script>