<!-- Last Login Info -->
<% if (session.admin && session.admin.last_login) { %>
    <div class="alert alert-info mb-4" style="background: #d1ecf1; border-left: 4px solid #17a2b8; border-radius: 10px;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-history me-2"></i> 
                <strong>Last Login:</strong> <%= new Date(session.admin.last_login).toLocaleString() %>
                <% if (session.admin.last_login_ip) { %>
                    <span class="ms-3"><i class="fas fa-network-wired me-1"></i> IP: <%= session.admin.last_login_ip %></span>
                <% } %>
            </div>
            <i class="fas fa-shield-alt" style="font-size: 1.2rem; opacity: 0.7;"></i>
        </div>
    </div>
<% } else { %>
    <div class="alert alert-info mb-4" style="background: #d1ecf1; border-left: 4px solid #17a2b8; border-radius: 10px;">
        <i class="fas fa-history me-2"></i> Welcome to your dashboard! This is your first login.
    </div>
<% } %>

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-4">
                <div class="stats-card">
                    <h5>Total Bookings</h5>
                    <div class="stats-number"><%= stats.totalBookings %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h5>Revenue</h5>
                    <div class="stats-number">$<%= stats.totalRevenue.toLocaleString() %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h5>Occupancy Rate</h5>
                    <div class="stats-number"><%= stats.occupancy %>%</div>
                </div>
            </div>
        </div>

        <div class="stats-card mt-4">
            <h5>Recent Bookings</h5>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentBookings && recentBookings.length > 0) { %>
                            <% recentBookings.forEach(booking => { 
                                // FIXED: Access guest data correctly
                                let guestName = 'N/A';
                                if (booking.guest) {
                                    guestName = `${booking.guest.first_name || ''} ${booking.guest.last_name || ''}`.trim();
                                    if (!guestName) guestName = booking.guest.email || 'N/A';
                                } else if (booking.Guest) {
                                    guestName = `${booking.Guest.first_name || ''} ${booking.Guest.last_name || ''}`.trim();
                                    if (!guestName) guestName = booking.Guest.email || 'N/A';
                                }
                                
                                let roomNumber = 'N/A';
                                if (booking.Room) {
                                    roomNumber = booking.Room.room_number;
                                } else if (booking.room) {
                                    roomNumber = booking.room.room_number;
                                }
                            %>
                                <tr>
                                    <td><%= guestName %></td>
                                    <td>Room <%= roomNumber %></td>
                                    <td><%= new Date(booking.check_in).toLocaleDateString() %></td>
                                    <td><%= new Date(booking.check_out).toLocaleDateString() %></td>
                                    <td>$<%= booking.total_amount %></td>
                                    <td><span class="badge bg-<%= booking.status === 'confirmed' ? 'success' : 'warning' %>"><%= booking.status %></span></td>
                                
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center">No recent bookings</td
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>