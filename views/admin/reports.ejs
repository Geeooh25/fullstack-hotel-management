<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-4">
                <div class="stats-card">
                    <h5>Total Bookings</h5>
                    <div class="stats-number"><%= totalBookings || 0 %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h5>Total Revenue</h5>
                    <div class="stats-number">$<%= (totalRevenue || 0).toLocaleString() %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stats-card">
                    <h5>Reports Generated</h5>
                    <div class="stats-number"><%= recentBookings ? recentBookings.length : 0 %></div>
                </div>
            </div>
        </div>
        
        <div class="stats-card mt-4">
            <h5>Recent Activity</h5>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Booking ID</th><th>Guest</th><th>Amount</th><th>Date</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <% if (recentBookings && recentBookings.length > 0) { %>
                            <% recentBookings.forEach(booking => { %>
                                <tr>
                                    <td>#<%= booking.id %></td>
                                    <td><%= booking.guest ? booking.guest.first_name + ' ' + booking.guest.last_name : 'N/A' %></td>
                                    <td>$<%= booking.total_amount %></td>
                                    <td><%= new Date(booking.created_at).toLocaleDateString() %></td>
                                    <td><span class="badge bg-success"><%= booking.status %></span></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center">No recent activity</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>