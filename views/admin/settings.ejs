<div class="row">
    <div class="col-md-12">
        <div class="stats-card">
            <h5>System Settings</h5>
            <form id="settingsForm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hotel Name</label>
                        <input type="text" name="hotel_name" class="form-control" value="<%= settings.hotel_name || 'GEEOOH HOTEL' %>">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hotel Email</label>
                        <input type="email" name="hotel_email" class="form-control" value="<%= settings.hotel_email || 'info@geeooohotel.com' %>">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="hotel_phone" class="form-control" value="<%= settings.hotel_phone || '+1 (555) 123-4567' %>">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tax Rate (%)</label>
                        <input type="number" name="tax_rate" class="form-control" step="0.01" value="<%= settings.tax_rate || 10 %>">
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="hotel_address" class="form-control" rows="2"><%= settings.hotel_address || '123 Luxury Avenue, Beverly Hills, CA 90210' %></textarea>
                    </div>
                </div>
                <button type="submit" class="btn-gold">Save Settings</button>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('settingsForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());
        
        const response = await fetch('/admin/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (response.ok) alert('Settings saved!');
    });
</script>