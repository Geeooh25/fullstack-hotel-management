<div class="row">
    <div class="col-md-12">
        <div class="stats-card">
            <h5>Booking Details</h5>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Booking Reference:</strong> <%= booking.booking_reference %></p>
                    <p><strong>Guest Name:</strong> <%= booking.guest ? booking.guest.first_name + ' ' + booking.guest.last_name : 'N/A' %></p>
                    <p><strong>Email:</strong> <%= booking.guest ? booking.guest.email : 'N/A' %></p>
                    <p><strong>Phone:</strong> <%= booking.guest ? booking.guest.phone : 'N/A' %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Room:</strong> <%= booking.Room ? booking.Room.room_number : 'N/A' %></p>
                    <p><strong>Check-in:</strong> <%= new Date(booking.check_in).toLocaleDateString() %></p>
                    <p><strong>Check-out:</strong> <%= new Date(booking.check_out).toLocaleDateString() %></p>
                    <p><strong>Total Amount:</strong> $<%= booking.total_amount %></p>
                    <p><strong>Status:</strong> <span class="badge bg-warning"><%= booking.status %></span></p>
                </div>
            </div>
            <div class="mt-3">
    <a href="/admin/bookings/<%= booking.id %>/receipt" class="btn-gold" target="_blank">
        <i class="fas fa-download"></i> Download Receipt (PDF)
    </a>
    <a href="/admin/bookings" class="btn btn-secondary">Back to Bookings</a>
</div>
        </div>
    </div>
</div>