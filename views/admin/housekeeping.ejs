<div class="row">
    <div class="col-md-12">
        <div class="stats-card">
            <h5>Housekeeping Management</h5>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Room</th><th>Type</th><th>Status</th><th>Last Cleaned</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (rooms && rooms.length > 0) { %>
                            <% rooms.forEach(room => { %>
                                <tr>
                                    <td><strong>Room <%= room.room_number %></strong></td>
                                    <td><%= room.RoomType ? room.RoomType.name : 'Standard' %></td>
                                    <td>
                                        <span class="badge bg-<%= room.status === 'available' ? 'success' : room.status === 'occupied' ? 'danger' : 'warning' %>">
                                            <%= room.status %>
                                        </span>
                                    </td>
                                    <td><%= room.last_cleaned ? new Date(room.last_cleaned).toLocaleDateString() : 'Not recorded' %></td>
                                    <td>
                                        <button class="btn btn-sm btn-success mark-cleaned" data-id="<%= room.id %>">
                                            <i class="fas fa-check"></i> Mark Cleaned
                                        </button>
                                    </td>
                                
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center">No rooms found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.mark-cleaned').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.dataset.id;
            const response = await fetch(`/api/rooms/${id}/clean`, { method: 'POST' });
            if (response.ok) location.reload();
        });
    });
</script>