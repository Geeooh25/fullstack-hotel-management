<div class="row">
    <div class="col-md-12">
        <div class="stats-card">
            <h5>Guest Details</h5>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Name:</strong> <%= guest.first_name %> <%= guest.last_name %></p>
                    <p><strong>Email:</strong> <%= guest.email %></p>
                    <p><strong>Phone:</strong> <%= guest.phone || 'N/A' %></p>
                    <p><strong>Address:</strong> <%= guest.address || 'N/A' %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Total Bookings:</strong> <%= guest.bookings ? guest.bookings.length : 0 %></p>
                    <p><strong>Member Since:</strong> <%= new Date(guest.created_at).toLocaleDateString() %></p>
                </div>
            </div>
            <h6 class="mt-4">Booking History</h6>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Booking Ref</th><th>Room</th><th>Dates</th><th>Total</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <% if (guest.bookings && guest.bookings.length > 0) { %>
                            <% guest.bookings.forEach(booking => { %>
                                <tr>
                                    <td><%= booking.booking_reference %></td>
                                    <td>Room <%= booking.Room ? booking.Room.room_number : 'N/A' %></td>
                                    <td><%= new Date(booking.check_in).toLocaleDateString() %> - <%= new Date(booking.check_out).toLocaleDateString() %></td>
                                    <td>$<%= booking.total_amount %></td>
                                    <td><span class="badge bg-secondary"><%= booking.status %></span></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center">No bookings found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <a href="/admin/guests" class="btn btn-secondary mt-3">Back to Guests</a>
        </div>
    </div>
</div>